# Copy to .env and fill in real values. Do not commit .env.

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seriousvibes

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-byte-random-string

# CORS — comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3000

# API port (web reverse-proxies via Next rewrites in dev)
API_PORT=3001

# Web → API base URL (only set in deployment, dev uses Next rewrites)
# NEXT_PUBLIC_API_BASE_URL=
