{
  "name": "seriousvibes",
  "version": "0.1.0",
  "private": true,
  "description": "A serious starter for vibe coders.",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm-run-all --parallel build:api build:web",
    "build:api": "npm run build -w api",
    "build:web": "npm run build -w web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate -w api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
